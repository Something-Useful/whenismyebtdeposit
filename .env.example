# Copy to .env.local (gitignored) and fill in for your deployment.

# Canonical URL for OG tags, sitemap, and embed snippet URLs.
# Defaults to the production domain when unset — see lib/site-url.ts.
#NEXT_PUBLIC_SITE_URL=https://your-domain.example

# GoatCounter analytics endpoint for your own account. When unset (the
# default), the site ships no analytics at all — see app/layout.tsx.
#NEXT_PUBLIC_GOATCOUNTER_URL=https://YOURCODE.goatcounter.com/count

# Formspree endpoint for the /partner contact form. When unset, the form
# opens a prefilled email to OPERATOR.contactEmail instead — see
# components/PartnersContact.tsx.
#NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/YOURFORMID
